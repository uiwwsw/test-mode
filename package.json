{
  "name": "@uiwwsw/test-mode",
  "version": "0.1.0",
  "description": "Framework-neutral API scenario runtime for development and QA: fetch mocks, response patches, browser controls, and server adapters.",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "license": "MIT",
  "author": "uiwwsw",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "docs/*.md",
    "templates/test-mode",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "test:package": "node scripts/check-package.mjs",
    "ci": "npm run typecheck && npm test && npm run test:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm run ci",
    "pack:dry-run": "npm pack --dry-run",
    "release:check": "node scripts/check-release.mjs"
  },
  "keywords": [
    "api",
    "mock",
    "story",
    "scenario",
    "test-mode",
    "fetch",
    "overlay",
    "vanilla"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uiwwsw/test-mode.git"
  },
  "bugs": {
    "url": "https://github.com/uiwwsw/test-mode/issues"
  },
  "homepage": "https://github.com/uiwwsw/test-mode#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3"
  }
}
